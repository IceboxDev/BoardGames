{
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @boardgames/web dev",
    "dev:all": "concurrently --names server,web --prefix-colors blue,green \"$npm_execpath --filter @boardgames/server dev\" \"$npm_execpath --filter @boardgames/web dev\"",
    "build": "pnpm -r build",
    "extract-accents": "node scripts/extract-accents.mjs",
    "bgg-sync": "node --env-file=packages/server/.env scripts/bgg-sync.mjs",
    "gen-descriptions": "tsx --env-file=packages/server/.env scripts/gen-descriptions/index.mjs",
    "gen-skills": "tsx --env-file=packages/server/.env scripts/gen-skills.mjs",
    "gen-cpp-7wonders": "tsx scripts/gen-cpp-7wonders.ts",
    "gen-duet-campaign-map": "tsx scripts/gen-duet-campaign-map.mts && biome format --write packages/web/src/games/codenames-duet/campaign/world-map.gen.ts",
    "gen-cpp-hunger": "tsx scripts/gen-cpp-hunger.ts",
    "dump-hunger-parity": "tsx scripts/dump-hunger-parity.ts",
    "build-hunger-wasm": "tsx scripts/gen-hunger-wasm.ts",
    "prebuild": "pnpm extract-accents",
    "lint": "biome check packages/ && node scripts/lint-styles.mjs && node scripts/lint-tests.mjs",
    "lint:styles": "node scripts/lint-styles.mjs",
    "lint:tests": "node scripts/lint-tests.mjs",
    "lint:styles:baseline": "node scripts/lint-styles.mjs --check-baseline",
    "lint:fix": "biome check --write packages/",
    "format": "biome format --write packages/",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/test-run.mjs core server web",
    "test:heavy": "pnpm --filter @boardgames/core test:heavy",
    "geography-import": "tsx scripts/geography-import.ts",
    "quiz-ingest": "tsx scripts/quiz-ingest/cli.ts",
    "quiz-evidence": "tsx scripts/quiz-evidence/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@libsql/client": "^0.17.3",
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "concurrently": "^9.0.0",
    "d3-geo": "^3.1.1",
    "fast-xml-parser": "^5.7.2",
    "lefthook": "^2.1.4",
    "node-vibrant": "^4.0.4",
    "playwright-core": "^1.64.0",
    "railway": "^3.11.0",
    "sharp": "^0.34.5",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.21.0",
    "typescript": "~5.7.0",
    "vitest": "^4.1.5",
    "zod": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "lefthook",
      "sharp"
    ],
    "overrides": {
      "zod": "^4"
    }
  },
  "dependencies": {
    "ai": "^7.0.165"
  }
}
