{"seq":6,"at":"2026-10-21","kind":"edited","target":{"type":"article","id":"a0857"},"reason":"Proofread (reasons in the entries above / the batch report).","by":"enrich batch 199","ref":"quiz-archive/runs/tp-enrich/enrich-report/a0065-a1025.md","changes":[{"field":"bodyEn","diff":[["=",440],["+","Garrincha and "],["=",2],["-","teenage"],["+","young"],["=",3],["-","and"],["+","(only"],["=",1],["-","Garrincha"],["+","17"],["=",1],["+","in 1958) "],["=",188],["-","1982,,"],["+","1982,"],["=",557],["-","circle,"],["+","circle"],["=",1],["+","– not even in 2022, when Argentina beat France on penalties in Qatar for its third title – "],["=",35]]},{"field":"bodyDe","diff":[["=",420],["+","Garrincha und "],["=",2],["-","jugendlichen"],["+","jungen"],["=",3],["-","und"],["+","(1958"],["=",1],["-","Garrincha"],["+","erst"],["=",1],["+","17) "],["=",720],["-","vorgedrungen,"],["+","vorgedrungen"],["=",1],["+","– auch nicht 2022, als Argentinien in Katar Frankreich im Elfmeterschießen schlug und seinen dritten Titel holte –, "],["=",25]]}],"hash":"d7c3f3bb0de6"},
