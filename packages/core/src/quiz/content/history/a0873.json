hr Name ging "],["=",10],["-","einging."],["+","ein."],["=",77],["-","Femur"],["+","Femur,"],["=",1],["+","der Oberschenkelknochen, "],["=",8],["-","(der Oberschenkelknochen) "],["=",204],["-","Ulna"],["+","Ulna,"],["=",1],["+","die Elle, "],["=",6],["-","(die Elle) "],["=",84],["-","Scapula"],["+","Scapula,"],["=",1],["+","das Schulterblatt, "],["=",16],["-","(das Schulterblatt) "],["=",449]]},{"field":"notesEn","old":"","new":"Naming the bone instead of the place also counts: the toes, the kneecap, the shoulder blade, the thighbone, the ulna."},{"field":"notesDe","old":"","new":"Auch der Name des Knochens statt des Ortes zählt: die Zehen, die Kniescheibe, das Schulterblatt, der Oberschenkelknochen, die Elle."}],"hash":"d06af49c846b"},
