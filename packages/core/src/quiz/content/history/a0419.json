{"seq":5,"at":"2026-10-21","kind":"edited","target":{"type":"article","id":"a0419"},"reason":"Proofread (reasons in the entries above / the batch report).","by":"enrich batch 153","ref":"quiz-archive/runs/tp-enrich/enrich-report/a0407-a0731.md","changes":[{"field":"bodyEn","diff":[["=",94],["-","**Grasses"],["+","**Grasses**"],["=",1],["-","(Poaceae)**,"],["+","(Poaceae)"],["=",1],["-","called Süßgräser in German, "],["=",20],["-","is"],["+","belongs"],["=",1],["-","a"],["+","to"],["=",1],["-","grass:"],["+","the"],["=",1],["+","grasses: "],["=",172],["-","**Legumes"],["+","**Legumes**"],["=",1],["-","(Fabaceae)**"],["+","(Fabaceae)"],["=",23],["-","members,"],["+","legumes,"],["=",189],["-","Phasin"],["+","phasin,"],["=",1],["-","(phytohaemagglutinin),"],["+","also"],["=",1],["+","called phytohaemagglutinin, "],["=",40],["-","**Nightshades"],["+","**Nightshades**"],["=",1],["-","(Solanaceae)**"],["+","(Solanaceae)"],["=",77],["+","are "],["=",2],["-","belong"],["+","nightshades,"],["=",1],["-","to this family, "],["=",4],["-","do"],["+","are"],["=",79],["-","**Crucifers"],["+","**Crucifers**"],["=",1],["-","(Brassicaceae)**"],["+","(Brassicaceae)"],["=",85],["-","their"],["+","crucifers"],["=",1],["-","cousins,"],["+","too,"],["=",75],["-","**Rose"],["+","Plants"],["=",1],["-","family"],["+","of"],["=",1],["-","(Rosaceae)**"],["+","the"],["=",1],["-","plants"],["+","**rose"],["=",1],["+","family** (Rosaceae) "],["=",68],["-","list."],["+","list,"],["=",1],["+","and every one of them belongs to the rose family. "],["=",211]]},{"field":"bodyDe","diff":[["=",116],["-","Jede"],["+","Alle"],["=",1],["-","Getreideart"],["+","Getreidearten"],["=",1],["-","ist"],["+","sind"],["=",1],["-","ein"],["+","Süßgräser:"],["=",1],["-","Gras: "],["=",194],["-","gehören"],["+","sind"],["=",1],["-","dazu,"],["+","Hülsenfrüchtler,"],["=",185],["-","Phasin"],["+","Phasin,"],["=",1],["-","(Phytohämagglutinin),"],["+","auch"],["=",1],["+","Phytohämagglutinin genannt, "],["=",98],["-","gehören"],["+","sind"],["=",1],["-","alle"],["+","allesamt"],["=",1],["-","zu"],["+","Nachtschattengewächse,"],["=",1],["-","dieser Familie, "],["=",146],["-","ihre"],["+","ebenfalls"],["=",1],["-","Vettern,"],["+","Kreuzblütler,"],["=",137],["-","Liste."],["+","Liste"],["=",1],["+","– sie alle sind Rosengewächse. "],["=",201]]},{"field":"notesEn","diff":[["+","Botanical names are also accepted: grasses = Poaceae (Gramineae), legumes = Fabaceae, nightshades = Solanaceae, crucifers = Brassicaceae, rose family = Rosaceae. Phasin is also accepted as phytohaemagglutinin (PHA). "],["=",25]]},{"field":"notesDe","diff":[["=",2],["-","richtig:"],["+","die"],["=",1],["-","Gräser"],["+","botanischen"],["=",1],["-","(Poaceae)."],["+","Namen"],["=",1],["+","gelten: Süßgräser (auch: Gräser) = Poaceae, Hülsenfrüchtler = Fabaceae, Nachtschattengewächse = Solanaceae, Kreuzblütler = Brassicaceae, Rosengewächse = Rosaceae. Phasin gilt auch als Phytohämagglutinin (PHA). "],["=",17]]}],"hash":"08381121b1e9"},
