{"seq":7,"at":"2026-10-21","kind":"edited","target":{"type":"article","id":"a0819"},"reason":"Proofread (reasons in the entries above / the batch report).","by":"enrich batch 011","ref":"quiz-archive/runs/tp-enrich/enrich-report/a0735-a1035.md","changes":[{"field":"bodyEn","diff":[["=",316],["+","Pablo "],["=",182],["-","was"],["+","pursued"],["=",1],["-","pursuing "],["=",8],["-","modernity."],["+","modernity:"],["=",281],["-","earlier,"],["+","before"],["=",1],["+","The Scream, "],["=",130],["-","Ursa"],["+","the"],["=",1],["-","Major"],["+","Big"],["=",1],["-","(the"],["+","Dipper,"],["=",1],["-","Big"],["+","the"],["=",1],["-","Dipper)"],["+","brightest"],["=",1],["+","part of the constellation Ursa Major, "],["=",217]]},{"field":"bodyDe","diff":[["=",306],["+","Pablo "],["=",194],["-","Moderne."],["+","Moderne:"],["=",277],["-","zuvor,"],["+","vor"],["=",1],["+","dem „Schrei“, "],["=",128],["-","Sternbilds"],["+","Großen"],["=",1],["-","Großer"],["+","Wagens"],["=",1],["-","Bär"],["+","funkeln,"],["=",1],["-","(Großer"],["+","des"],["=",1],["-","Wagen)"],["+","hellsten"],["=",1],["-","funkeln."],["+","Teils des Sternbilds Großer Bär."],["=",202]]},{"field":"notesEn","old":"","new":"Starry Night Over the Rhône: the seven stars are the Big Dipper (the Plough), the best-known part of Ursa Major (the Great Bear); \"the Big Dipper\" is accepted too."},{"field":"notesDe","old":"","new":"Sternennacht über der Rhone: Die sieben Sterne sind der Große Wagen, der bekannteste Teil des Sternbilds Großer Bär; „Großer Wagen“ gilt ebenfalls."}],"hash":"2f671f2b9d59"},
