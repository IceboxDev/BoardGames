,["+","„Klümpchen“,"],["=",1],["-","gebracht,"],["+","hergeleitet"],["=",1],["-","in"],["+","–"],["=",1],["-","dem"],["+","derselben"],["=",1],["-","die"],["+","Wurzel"],["=",1],["+","wie Tupfen –, weil Quark aus Klümpchen geronnener "],["=",2],["-","einst"],["+","besteht,"],["=",1],["-","gerann"],["+","auch"],["=",1],["-","und"],["+","wenn"],["=",1],["-","abtropfte."],["+","viele"],["=",1],["+","es mit dem Topf in Verbindung bringen. "],["=",437]]},{"field":"notesEn","old":"","new":"Powidl is plum butter, also described as a thick plum jam."},{"field":"notesDe","old":"","new":"Powidl ist Pflaumenmus (Zwetschgenmus)."}],"hash":"3de8556ff7dd"},
