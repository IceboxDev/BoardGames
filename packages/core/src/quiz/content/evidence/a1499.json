    {
     "source": "s2",
     "quote": "Die Gemeine Fichte (Picea abies), auch Gewöhnliche Fichte, Rotfichte oder Rottanne, früher auch Schwarztanne oder Pechtanne genannt, ist eine Pflanzenart in der Gattung der Fichten (Picea).",
     "quoteLang": "de",
     "verbatim": true,
     "verifiedAt": "2026-10-23T06:27:35.386Z"
    }
