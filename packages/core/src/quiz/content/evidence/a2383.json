   "support": [
    {
     "source": "s1",
     "quote": "Hier wie dort dem Fußball verschrieben: Jakob Schmid und Franz Berzel waren Fußballer beim 1. FC Regensburg und suchten auch auf ihrer Reise immer wieder die Nähe von Sportskameraden.",
     "quoteLang": "de",
     "verbatim": true,
     "verifiedAt": "2026-10-23T06:30:10.099Z"
    }
   ],
   "by": "crawler",
   "run": "evidence-crawl-2026-10-23",
   "note": "answer check: “1. FC Regensburg” is on the snapshot of s1"
  },
