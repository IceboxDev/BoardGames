   "verdict": "confirmed",
   "confidence": "high",
   "support": [
    {
     "source": "s12",
     "quote": "These insects are often called 'holometabolous', meaning they undergo a complete (holo = total) change (metabolous = metamorphosis or change).",
     "quoteLang": "en",
     "verbatim": true
    }
   ],
   "by": "research-r046",
   "run": "provenance-research-2026-10-23"
  },
  {
