   "verdict": "confirmed",
   "confidence": "high",
   "support": [
    {
     "source": "s13",
     "quote": "Holometabolism, also called complete metamorphosis, is a form of insect development which includes four life stages: egg, larva, pupa, and imago (or adult).",
