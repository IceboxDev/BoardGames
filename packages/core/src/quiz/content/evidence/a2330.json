   "claim": "answer",
   "verdict": "confirmed",
   "confidence": "medium",
   "support": [
    {
     "source": "s3",
     "quote": "The top and middle texts are in Ancient Egyptian using hieroglyphic and Demotic scripts, respectively, while the bottom is in Ancient Greek.",
