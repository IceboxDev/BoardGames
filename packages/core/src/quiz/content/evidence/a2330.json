   "support": [
    {
     "source": "s3",
     "quote": "Since 1802, it has been on public display at the British Museum almost continuously and it is the most visited object there.",
     "quoteLang": "en",
     "verbatim": true,
     "verifiedAt": "2026-10-23T06:29:57.776Z"
    }
   ],
   "by": "crawler",
   "run": "evidence-crawl-2026-10-23",
   "note": "answer check: “British Museum” is on the snapshot of s3"
  },
  {
   "id": "e10",
   "at": "2026-10-23T06:29:57.776Z",
   "target": "f12115",
   "claim": "answer",
   "verdict": "confirmed",
   "confidence": "medium",
   "support": [
    {
     "source": "s3",
     "quote": "The Rosetta Stone is a stele of granodiorite inscribed with three versions of a decree issued in 196 BC during the Ptolemaic dynasty of Egypt, on behalf of King Ptolemy V Epiphanes.",
     "quoteLang": "en",
     "verbatim": true,
     "verifiedAt": "2026-10-23T06:29:57.776Z"
    }
   ],
   "by": "crawler",
   "run": "evidence-crawl-2026-10-23",
   "note": "answer check: “Ptolemy V” is on the snapshot of s3"
  },
  {
