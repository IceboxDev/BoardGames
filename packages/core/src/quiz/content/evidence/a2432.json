   "verdict": "confirmed",
   "confidence": "medium",
   "support": [
    {
     "source": "s1",
     "quote": "Da erscheint plötzlich Tschick mit einem gestohlenen, klapprigen, hellblauen Lada Niva vor der Haustür.",
     "quoteLang": "de",
     "verbatim": true,
     "verifiedAt": "2026-10-23T06:30:19.388Z"
    }
   ],
   "by": "crawler",
