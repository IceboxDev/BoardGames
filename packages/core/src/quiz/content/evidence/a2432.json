    {
     "source": "s1",
     "quote": "Auch der neue Mitschüler Tschick (eigentlich Andrej Tschichatschow), ein wortkarger russischer Spätaussiedler, der hin und wieder sichtlich betrunken zum Unterricht erscheint, ist ein Außenseiter.",
     "quoteLang": "de",
     "verbatim": true,
     "verifiedAt": "2026-10-23T06:30:19.388Z"
    }
   ],
   "by": "crawler",
   "run": "evidence-crawl-2026-10-23",
   "note": "answer check: “Andrej Tschichatschow” is on the snapshot of s1"
  },
