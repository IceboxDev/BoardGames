   "support": [
    {
     "source": "s5",
     "quote": "In tennis, an ace is a legal serve that is not touched by the receiver, winning the point for the server.",
     "quoteLang": "en",
     "verbatim": true,
     "verifiedAt": "2026-10-23T06:28:25.041Z"
    }
