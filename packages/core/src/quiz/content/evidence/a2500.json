   "support": [
    {
     "source": "s2",
     "quote": "Koi (Japanese: 鯉; Japanese: [koꜜi], literally 'carp'), or more specifically nishikigoi (錦鯉; Japanese: [ɲiɕi̥kiꜜɡoi], literally 'brocaded carp'), are colored varieties of carp (Cyprinus sp.) that are kept for decorative purposes in outdoor koi ponds or water gardens.",
     "quoteLang": "en",
     "verbatim": true,
     "verifiedAt": "2026-10-23T06:30:30.008Z"
    }
   ],
   "by": "crawler",
