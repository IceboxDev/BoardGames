   "run": "provenance-research-2026-10-23",
   "note": "Several other mammals also yield ivory; the card asks for two, elephant and walrus being the classic pair."
  },
  {
   "id": "e19",
   "at": "2026-10-23T08:13:51Z",
   "target": "f04252",
