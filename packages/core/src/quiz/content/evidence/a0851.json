   "verdict": "confirmed",
   "confidence": "high",
   "support": [
    {
     "source": "s12",
     "quote": "They are the only mammals still in existence which lay eggs , rather than bearing live young. The five extant monotreme species are the platypus and the four species of echidnas .",
     "quoteLang": "en",
     "verbatim": true
    }
   ],
   "by": "research-r048",
   "run": "provenance-research-2026-10-23"
  },
  {
