   "verdict": "confirmed",
   "confidence": "high",
   "support": [
    {
     "source": "s13",
     "quote": "Platypuses are grouped in a separate order of mammals known as monotremes, which are distinguished from all other mammals because they lay eggs.",
     "quoteLang": "en",
     "verbatim": true
    }
