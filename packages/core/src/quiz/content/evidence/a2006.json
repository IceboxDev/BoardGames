   "support": [
    {
     "source": "s9",
     "quote": "Die Kariben nennen sich in ihrer Sprache caribe, cariba, caniba (ursprünglich ‘stark, tapfer, geschickt, klug’).",
     "quoteLang": "de",
     "verbatim": true
    }
   ],
   "by": "research-r031",
   "run": "provenance-research-2026-10-23",
   "note": "DWDS continues: Columbus took the term over from Carib dialects; Spanish caníbal gives German Kannibale and English cannibal."
  },
