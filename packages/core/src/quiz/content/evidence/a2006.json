   "confidence": "medium",
   "support": [
    {
     "source": "s6",
     "quote": "borrowed from a Slavic tribe self-name *Slověne, turned into σκλάβος, ἐσκλαβῆνος (Late Latin sclāvus) in the meaning 'prisoner of war slave', 'slave' in the 8th/9th century, because they often became captured and enslaved.",
     "quoteLang": "en",
     "verbatim": true
    }
   ],
   "by": "research-r031",
   "run": "provenance-research-2026-10-23",
   "note": "The Slavic derivation is the widespread view; an alternative (Greek skyláō) has been proposed and criticised."
  },
  {
   "id": "e9",
   "at": "2026-10-23T07:45:09Z",
   "target": "f10028",
   "claim": "answer",
   "verdict": "confirmed",
   "confidence": "high",
   "support": [
    {
     "source": "s7",
     "quote": "Das Substantiv ist gleichen Ursprungs wie Slawe.",
     "quoteLang": "de",
     "verbatim": true
    }
   ],
   "by": "research-r031",
   "run": "provenance-research-2026-10-23"
  },
  {
   "id": "e10",
   "at": "2026-10-23T07:45:12Z",
   "target": "f10028",
   "claim": "answer",
   "verdict": "confirmed",
   "confidence": "high",
   "support": [
    {
     "source": "s8",
     "quote": "mittelgriechisch sklábos = Sklave, eigentlich = Slawe (die mittelalterlichen Sklaven im Orient waren meist Slawen)",
     "quoteLang": "de",
     "verbatim": true
    }
   ],
   "by": "research-r031",
   "run": "provenance-research-2026-10-23"
  },
  {
