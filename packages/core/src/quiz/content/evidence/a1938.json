    {
     "source": "s9",
     "quote": "Die Ausrufung der Republik in Deutschland geschah am 9. November 1918 in Berlin gleich zweimal: durch den MSPD-Politiker Philipp Scheidemann am Reichstagsgebäude unter bürgerlich-demokratischen und durch den Führer des Spartakusbundes Karl Liebknecht am Berliner Schloss",
     "quoteLang": "de",
     "verbatim": true
    }
   ],
   "by": "research-r036",
   "run": "provenance-research-2026-10-23"
  },
  {
