   "verdict": "confirmed",
   "confidence": "high",
   "support": [
    {
     "source": "s10",
     "quote": "Er ruft vom Reichstag die \"deutsche Republik\" aus. Etwa zwei Stunden später verkündet Karl Liebknecht die \"freie sozialistische Republik\".",
     "quoteLang": "de",
     "verbatim": true
    }
   ],
   "by": "research-r036",
   "run": "provenance-research-2026-10-23"
