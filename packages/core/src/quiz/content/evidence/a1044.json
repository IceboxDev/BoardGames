   "run": "provenance-research-2026-10-23"
  },
  {
   "id": "e27",
   "at": "2026-10-23T10:32:00Z",
   "target": "f05220",
   "claim": "answer",
   "verdict": "confirmed",
   "confidence": "high",
   "support": [
    {
     "source": "s15",
     "quote": "The Z3, an early computer built by German engineer Konrad Zuse working in complete isolation from developments elsewhere, uses 2,300 relays, performs floating point binary arithmetic, and has a 22-bit word length.",
     "quoteLang": "en",
     "verbatim": true
    }
   ],
