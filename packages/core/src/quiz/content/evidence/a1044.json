    {
     "source": "s7",
     "quote": "The Z3 was a German electromechanical computer designed by Konrad Zuse in 1938, and completed in 1941. It was the world's first working programmable, fully automatic digital computer.",
     "quoteLang": "en",
     "verbatim": true
    }
   ],
