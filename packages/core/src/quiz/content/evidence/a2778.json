   "support": [
    {
     "source": "s5",
     "quote": "In 1941, management consultant Joseph M. Juran developed the concept in the context of quality control and improvement after reading the works of Italian sociologist and economist Vilfredo Pareto, who wrote in 1906 about the 80:20 connection while teaching at the University of Lausanne.",
     "quoteLang": "en",
     "verbatim": true,
     "verifiedAt": "2026-10-23T06:31:12.212Z"
    }
   ],
