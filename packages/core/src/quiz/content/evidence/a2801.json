   "verdict": "confirmed",
   "confidence": "medium",
   "support": [
    {
     "source": "s1",
     "quote": "Though regional variations may exclude certain tiles or add unique ones, it is typically played with a set of 144 tiles based on Chinese characters and symbols.",
