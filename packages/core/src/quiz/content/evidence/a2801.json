     "verbatim": true,
     "verifiedAt": "2026-10-23T06:31:14.968Z"
    }
   ],
   "by": "crawler",
   "run": "evidence-crawl-2026-10-23",
   "note": "answer check: “144” is on the snapshot of s2"
  },
