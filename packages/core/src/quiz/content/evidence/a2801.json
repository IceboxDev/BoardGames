   "claim": "answer",
   "verdict": "confirmed",
   "confidence": "medium",
   "support": [
    {
     "source": "s2",
     "quote": "It usually has at least 136 tiles (four copies of each of the Suit and Honor Tiles), most commonly 144, although sets originating from the United States or Southeast Asia will usually feature more tiles in the form of flowers or Jokers.",
