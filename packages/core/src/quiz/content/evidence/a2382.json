   "claim": "answer",
   "verdict": "confirmed",
   "confidence": "medium",
   "support": [
    {
     "source": "s2",
     "quote": "An outspoken advocate for sexual minorities, he founded the Scientific-Humanitarian Committee and the World League for Sexual Reform.",
     "quoteLang": "en",
     "verbatim": true,
     "verifiedAt": "2026-10-23T06:30:09.877Z"
    }
   ],
   "by": "crawler",
   "run": "evidence-crawl-2026-10-23",
   "note": "answer check: “Scientific-Humanitarian Committee” is on the snapshot of s2"
  },
  {
