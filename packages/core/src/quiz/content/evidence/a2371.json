   "confidence": "high",
   "support": [
    {
     "source": "s5",
     "quote": "Vor 65 Jahren unterzeichneten Deutschland und Italien das erste Abkommen, das deutschen Unternehmen ermöglichte, Arbeitskräfte aus Italien legal zu beschäftigen.",
     "quoteLang": "de",
     "verbatim": true
    }
   ],
   "by": "research-r066",
   "run": "provenance-research-2026-10-23"
  },
  {
