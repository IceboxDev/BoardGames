   "confidence": "high",
   "support": [
    {
     "source": "s10",
     "quote": "Under the revised law, a party would need to take at least 3.25 percent of the vote, up from two percent, to win a seat in parliament.",
     "quoteLang": "en",
     "verbatim": true
    }
   ],
   "by": "research-r061",
   "run": "provenance-research-2026-10-23"
