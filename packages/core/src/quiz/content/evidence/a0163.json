   "verdict": "confirmed",
   "confidence": "high",
   "support": [
    {
     "source": "s9",
     "quote": "Sofern eine wahlwerbende Partei nicht in einem Regionalwahlkreis ein Mandat (\"Grundmandat\") erzielt, muss sie mindestens vier Prozent der in ganz Österreich abgegebenen Stimmen erzielen, um Mandate zu erhalten.",
     "quoteLang": "de",
     "verbatim": true
    }
   ],
   "by": "research-r061",
   "run": "provenance-research-2026-10-23"
  },
  {
   "id": "e21",
   "at": "2026-10-23T10:22:15Z",
   "target": "f00814",
   "claim": "answer",
   "verdict": "confirmed",
   "confidence": "high",
   "support": [
    {
     "source": "s3",
     "quote": "it must either pass the threshold of at least 4% of all valid votes cast nationwide, or win one mandate (seat) in one of the regional electoral districts",
     "quoteLang": "en",
     "verbatim": true
    }
   ],
   "by": "research-r061",
   "run": "provenance-research-2026-10-23"
  },
  {
