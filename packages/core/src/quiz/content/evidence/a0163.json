   "confidence": "high",
   "support": [
    {
     "source": "s8",
     "quote": "Nicht an der Sitzverteilung nehmen Parteien teil, die weniger als 5 % der Zweitstimmen erhalten haben (Sperrklausel).",
     "quoteLang": "de",
     "verbatim": true
    }
   ],
   "by": "research-r061",
   "run": "provenance-research-2026-10-23"
  },
  {
   "id": "e19",
   "at": "2026-10-23T10:22:12Z",
   "target": "f00812",
   "claim": "answer",
   "verdict": "confirmed",
   "confidence": "high",
   "support": [
    {
     "source": "s2",
     "quote": "Demnach musste eine Partei bundesweit mindestens fünf Prozent der Zweitstimmen erhalten, um in den Bundestag einzuziehen.",
