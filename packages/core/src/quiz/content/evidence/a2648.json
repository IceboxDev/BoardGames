   "verdict": "confirmed",
   "confidence": "medium",
   "support": [
    {
     "source": "s2",
     "quote": "The oar rests in an elaborately carved wooden rest (forcola) shaped to project from the side of the craft so as to allow the slight drag of each  return stroke to pull the bow back to its forward course.",
