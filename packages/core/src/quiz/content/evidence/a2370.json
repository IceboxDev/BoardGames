   "support": [
    {
     "source": "s10",
     "quote": "Konnte eine Ehefrau bisher nur berufstätig sein, wenn dies mit den Interessen ihres Ehemanns und der Familie vereinbar war, stellt das neue Gesetz klar, dass beide Ehegatten gleichermaßen zur Haushaltsführung verpflichtet und zur Erwerbstätigkeit berechtigt sind",
     "quoteLang": "de",
     "verbatim": true
    }
   ],
   "by": "research-r066",
   "run": "provenance-research-2026-10-23",
   "note": "The reform law passed in 1976 took effect on 1 July 1977."
  },
  {
   "id": "e21",
   "at": "2026-10-23T10:45:27Z",
   "target": "f12365",
   "claim": "answer",
   "verdict": "confirmed",
   "confidence": "medium",
   "support": [
    {
     "source": "s11",
     "quote": "Berufstätig durfte sie nur sein, wenn sie 'ihre familiären Verpflichtungen nicht vernachlässigt'.",
     "quoteLang": "de",
     "verbatim": true
    }
   ],
   "by": "research-r066",
   "run": "provenance-research-2026-10-23",
   "note": "LTO quotes the popular account of the pre-1977 rule and adds that the husband's court-authorised right to terminate his wife's contracts (§ 1358 BGB) had already ended on 1 July 1958; the compatibility clause itself lasted until the 1977 reform."
  },
