{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Must not lag the ES2022 target in tsconfig.base.json: a lower `lib` hides
    // APIs the runtime actually has (Node 24 / modern browsers), e.g. Array#at.
    "lib": ["ES2022", "DOM"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsBuildInfo",
    "resolveJsonModule": true
  },
  "include": ["src"]
}
