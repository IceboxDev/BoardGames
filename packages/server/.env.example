# Server
PORT=3001

# Database — libsql URL from `turso db show <name> --url`. Required.
TURSO_DATABASE_URL=
# Auth token from `turso db tokens create <name>`. Required.
TURSO_AUTH_TOKEN=

# Production credentials, read ONLY by `db:backup -- --prod`. Local development
# should point TURSO_DATABASE_URL above at a STAGING copy so day-to-day work,
# ad-hoc scripts and stray tests cannot write to production:
#   turso db create boardgames-staging --from-db boardgames
#   turso db tokens create boardgames-staging
PROD_TURSO_DATABASE_URL=
PROD_TURSO_AUTH_TOKEN=

# Better Auth
# Generate a fresh secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Admin bootstrap — first user signing up with this email is auto-promoted
ADMIN_EMAIL=mantas_kandratavicius@yahoo.com

# Google OAuth (optional). Register an OAuth client at
# https://console.cloud.google.com/apis/credentials with redirect URI
# http://localhost:3001/api/auth/callback/google
# Leave both empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production-only: web origin allowed by CORS + Better Auth trustedOrigins
# Set on Railway (and similar) to your Vercel URL.
WEB_ORIGIN=

# The loopback dev origins (localhost:5173 etc.) are dropped from the CORS and
# WebSocket allowlists on the DEPLOYED server (detected via Railway's env
# vars) — with SameSite=None cookies, anything a member runs on localhost
# would otherwise get credentialed access to the live API.
#
# Local development needs no change: NODE_ENV=production above does not
# suppress them, because the check is "am I deployed", not NODE_ENV. Set this
# to 0 explicitly if you ever deploy somewhere other than Railway.
ALLOW_LOCALHOST_ORIGINS=

# Agent surface (/api/agent/*) — read-only endpoints authenticated by a
# vestauth (web-bot-auth / RFC 9421) request signature instead of a session.
# Comma-separated allowlist of agent UIDs; LEAVE EMPTY to keep the surface
# disabled (every /api/agent route 404s). See src/auth/agent-auth.ts.
VESTAUTH_ALLOWED_AGENT_UIDS=

# BGG XML API token — only needed when running `pnpm bgg-sync` to refresh
# the cache. Register an application at https://boardgamegeek.com/applications
# (manual approval), then paste the issued bearer token here.
BGG_API_TOKEN=

# ── AI (Vercel AI Gateway) ───────────────────────────────────────────────
# All AI features (Decrypto agents, D&D extraction/referee, avatars,
# gen-descriptions/gen-skills scripts) call models through the Vercel AI
# Gateway: one credit pool, provider hopping = changing a model slug below.
# Create the key in the Vercel dashboard → AI Gateway. Model ids are gateway
# slugs ("provider/model", dots for versions); list them at
# https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_API_KEY=

# Model overrides — all optional. Defaults live in
# packages/server/src/lib/ai/config.ts and mirror the pre-migration OpenAI
# ladder using the gateway FREE TIER: $5/month free credits on the dashboard's
# "Free Tier" model subset (rate-limited; excluded models 403 → clean 503).
AI_MODEL=                    # global default (fallback for the per-feature vars)
AI_MODEL_DND=                # D&D referee text calls
AI_MODEL_DND_EXTRACT=        # D&D PDF extraction (needs a PDF-capable model)
AI_MODEL_AVATAR=             # image-output model; "openai-image-tool" selects the
                             # legacy direct-OpenAI image_generation path
AI_MODEL_DESCRIPTIONS=       # gen-descriptions (default gpt-5.2 + OpenAI web_search)
AI_MODEL_SKILLS=             # gen-skills
DECRYPTO_MODEL_MEDIUM=       # per-tier slugs behind the Decrypto difficulty ladder
DECRYPTO_MODEL_HARD=
DECRYPTO_MODEL_EXPERT=
AI_MODEL_FALLBACKS=          # optional comma list of gateway failover models

# Transport per feature: stream (default — deltas keep Railway's egress path
# from severing quiet connections), sync, or openai-background (the legacy
# direct-OpenAI escape hatch; needs OPENAI_API_KEY and an openai/* slug).
AI_TRANSPORT=
AI_TRANSPORT_DND_EXTRACT=
AI_STREAM_IDLE_TIMEOUT_MS=   # stream idle guard, default 90000

AI_IMAGE_QUALITY=            # avatar quality hint: low | medium | high (default)
DECRYPTO_REASONING_EFFORT=   # low | medium (default) | high

# Kill switch for ALL AI features. Set to 1 to suspend every billed AI call
# without unsetting any keys: AI game seats fall back to the deterministic
# agents, billed routes return 503 NOT_CONFIGURED. Empty/0 = normal operation.
AI_SUSPENDED=

# Escape hatch / rollback only: used solely by the openai-background transport
# and the openai-image-tool avatar path. Bills OpenAI directly.
OPENAI_API_KEY=
OPENAI_MODEL=
