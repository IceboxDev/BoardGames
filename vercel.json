{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/vercel-build.sh",
  "installCommand": "pnpm install --frozen-lockfile --filter @boardgames/web... --ignore-scripts",
  "outputDirectory": "packages/web/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": { "pre": "board-games-server-", "suf": ".vercel.app" } }],
      "destination": "https://preview-api-not-configured.invalid/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://boardgamesserver-production.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
