// Generates the Codenames: Duet campaign map's geometry:
//   packages/web/src/games/codenames-duet/campaign/world-map.gen.ts
//
//   pnpm gen-duet-campaign-map
//
// Natural Earth 110m land (world-atlas) in a NaturalEarth1 projection fitted
// to the mission map's region, with Europe magnified the way the printed
// sheet does (nine of the 26 cities sit there). The magnifier is smooth —
// r' = r·(1 + m·e^-(r/s)²) — so no continent gets a hard squeezed band.
// City positions go through the same projection and magnifier.

import { writeFileSync } from "node:fs";
import {
  CITY_IDS,
  type CityId,
} from "../packages/core/src/games/codenames-duet/campaign/map.ts";
import { geoNaturalEarth1, geoPath } from "d3-geo";
import type { FeatureCollection, MultiPolygon, Polygon } from "geojson";
import { feature } from "topojson-client";
import type { GeometryCollection, Topology } from "topojson-specification";

const OUT = "packages/web/src/games/codenames-duet/campaign/world-map.gen.ts";
const LAND_URL = "https://cdn.jsdelivr.net/npm/world-atlas@2.0.2/land-110m.json";

export const WIDTH = 1000;
export const HEIGHT = 520;

/** [longitude, latitude] of each mission. */
const LON_LAT: Record<CityId, [number, number]> = {
  prague: [14.42, 50.08],
  berlin: [13.4, 52.52],
  london: [-0.13, 51.5],
  paris: [2.35, 48.86],
  madrid: [-3.7, 40.42],
  "monte-carlo": [7.42, 43.74],
  "vatican-city": [12.45, 41.9],
  montreal: [-73.57, 45.5],
  washington: [-77.04, 38.9],
  "los-alamos": [-106.3, 35.88],
  moscow: [37.62, 55.75],
  yakutsk: [129.7, 62.03],
  tokyo: [139.69, 35.68],
  shanghai: [121.47, 31.23],
  "hong-kong": [114.17, 22.32],
  bangkok: [100.5, 13.75],
  singapore: [103.82, 1.35],
  sydney: [151.21, -33.87],
  "cape-town": [18.42, -33.92],
  cairo: [31.24, 30.04],
  baghdad: [44.36, 33.31],
  dubai: [55.27, 25.2],
  mumbai: [72.88, 19.08],
  casablanca: [-7.59, 33.57],
  bogota: [-74.07, 4.71],
  "rio-de-janeiro": [-43.17, -22.91],
};

/** Which side of its dot a city's name sits, so labels clear the routes (as on the sheet). */
const LABEL_SIDE: Record<CityId, "t" | "b" | "l" | "r"> = {
  prague: "r",
  berlin: "t",
  london: "t",
  paris: "l",
  madrid: "l",
  "monte-carlo": "t",
  "vatican-city": "b",
  montreal: "t",
  washington: "r",
  "los-alamos": "b",
  moscow: "t",
  yakutsk: "l",
  tokyo: "t",
  shanghai: "l",
  "hong-kong": "l",
  bangkok: "r",
  singapore: "b",
  sydney: "t",
  "cape-town": "t",
  cairo: "b",
  baghdad: "t",
  dubai: "t",
  mumbai: "b",
  casablanca: "b",
  bogota: "l",
  "rio-de-janeiro": "l",
};

// The region: the Americas' west coast to Japan, Siberia to the Cape.
const region: [number, number][] = [];
for (let lon = -122; lon <= 158; lon += 4) region.push([lon, -40], [lon, 68]);
for (let lat = -40; lat <= 68; lat += 4) region.push([-122, lat], [158, lat]);
const projection = geoNaturalEarth1().fitExtent(
  [
    [10, 10],
    [WIDTH - 10, HEIGHT - 10],
  ],
  { type: "MultiPoint", coordinates: region },
);

const centre = projection([9, 48]);
if (!centre) throw new Error("Europe is off the map");
const [fx, fy] = centre;
const MAGNIFY = 1.25;
const SPREAD = 175;
const SQUASH = 1.1;
function magnify(x: number, y: number): [number, number] {
  const dx = x - fx;
  const dy = (y - fy) * SQUASH;
  const r = Math.hypot(dx, dy);
  if (r === 0) return [x, y];
  const k = 1 + MAGNIFY * Math.exp(-((r / SPREAD) ** 2));
  return [fx + dx * k, fy + (dy / SQUASH) * k];
}

const topology = (await (await fetch(LAND_URL)).json()) as Topology<{
  land: GeometryCollection;
}>;
const land = feature(topology, topology.objects.land) as FeatureCollection<Polygon | MultiPolygon>;
const raw = geoPath(
  projection.clipExtent([
    [0, 0],
    [WIDTH, HEIGHT],
  ]),
).digits(1)(land);
if (!raw) throw new Error("No land path");
const landPath = raw.replace(/(-?[\d.]+),(-?[\d.]+)/g, (_, a: string, b: string) => {
  const [x, y] = magnify(Number(a), Number(b));
  return `${x.toFixed(1)},${y.toFixed(1)}`;
});

const cities = CITY_IDS.map((id) => {
  const p = projection(LON_LAT[id]);
  if (!p) throw new Error(`${id} is off the map`);
  const [x, y] = magnify(p[0], p[1]);
  return `  "${id}": { x: ${x.toFixed(1)}, y: ${y.toFixed(1)}, label: "${LABEL_SIDE[id]}" },`;
});

writeFileSync(
  OUT,
  `// Generated by scripts/gen-duet-campaign-map.mts — do not edit. Regenerate with
// \`pnpm gen-duet-campaign-map\`. Natural Earth land (public domain) via world-atlas.

import type { CityId } from "@boardgames/core/games/codenames-duet/campaign/map";

export const MAP_WIDTH = ${WIDTH};
export const MAP_HEIGHT = ${HEIGHT};

export interface CityPoint {
  readonly x: number;
  readonly y: number;
  /** Which side of the dot the name sits on. */
  readonly label: "t" | "b" | "l" | "r";
}

export const CITY_POINTS: Readonly<Record<CityId, CityPoint>> = {
${cities.join("\n")}
};

export const LAND_PATH =
  "${landPath}";
`,
);
console.log(`wrote ${OUT} (${Math.round(landPath.length / 1024)} KB of land)`);
